# 忆程 ProjectMemo 环境变量全集
#
# 本文件是变量名的唯一事实来源：新增或改名环境变量时先改这里，README 只链接、不重复维护默认值。
# 复制为 .env 即可本地运行（`copy .env.example .env`），默认值全部指向离线 Mock，不需要任何密钥。
#
# 分组含义：
#   1. 数据与存储   —— 本地开发必须一致，生产必须指向持久卷
#   2. 发布标识     —— 证据与回执据此绑定版本
#   3. 模型（对话） —— 默认关闭真实调用
#   4. 模型（向量） —— 未配置时 Hybrid Search 退回关键词/元数据，不计入真实语义 Gate
#   5. 功能开关     —— 可选能力，出问题可单独回退
#   6. 演示账号     —— 仅本地/复赛演示使用，生产必须关闭
#   7. 附件抽取     —— 文本 PDF 走 pdftotext，图片走 NEEDS_OCR
#   8. 小艺适配层   —— 默认关闭，公网 HTTPS + 反向代理后才启用

# ---------------------------------------------------------------
# 1. 数据与存储
# ---------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"
# 附件落盘目录；留空时回退到项目内 storage/
ATTACHMENT_DIR=""

# ---------------------------------------------------------------
# 2. 发布标识（写入 /health 与验收回执，用于确认证据属于哪一次构建）
# ---------------------------------------------------------------
PROJECTMEMO_RELEASE="unversioned"
# 仅公网验收脚本使用：实际 release 与此不一致时 verify:w03-public 会失败
PROJECTMEMO_EXPECTED_RELEASE=""

# ---------------------------------------------------------------
# 3. 模型（对话）：mock = 完全离线确定性回退；openai-compatible = 真实调用
# ---------------------------------------------------------------
LLM_MODE="mock"
LLM_PROVIDER="deepseek"
LLM_BASE_URL="https://api.deepseek.com"
LLM_API_KEY=""
LLM_MODEL_NAME="deepseek-flash"
# 图片提取用的视觉模型。留空 = 复用 LLM_MODEL_NAME（推荐的默认行为）。
# DeepSeek 的 deepseek-flash 原生接受 image_url + base64，因此默认不需要单独填。
# 切勿填别家模型名（如 gpt-4o-mini）：那会把 DeepSeek 不认识的模型 id 发过去，
# 请求必然报错，图片会退化成 NEEDS_OCR 而不是真的"不支持图片"。
LLM_VISION_MODEL_NAME=""
LLM_TIMEOUT_MS="30000"

# ---------------------------------------------------------------
# 4. 模型（向量）
# DeepSeek 对话预设不会被自动当作 embedding 服务：启用真实语义检索必须显式配置
# EMBEDDING_BASE_URL + EMBEDDING_MODEL_NAME（+ API Key），且 LLM_MODE=openai-compatible。
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=""
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL_NAME=""
EMBEDDING_TIMEOUT_MS="15000"

# ---------------------------------------------------------------
# 5. 功能开关（取值：true / false；括号内为代码缺省值）
# ---------------------------------------------------------------
# 真实向量语义检索；未配置 embedding provider 时为 false，关键词/元数据 fallback 始终可用
SEMANTIC_MEMORY_ENABLED="false"
# 时间证据账本：提议 → 人工确认 → 可撤销关系（默认 true）
TEMPORAL_MEMORY_ENABLED="true"
# 证据可信回执：依据充分 / 存在冲突 / 证据不足（默认 true）
EVIDENCE_TRUST_RECEIPT_ENABLED="true"
# 项目状态快照与新鲜度（默认 false）
PROJECT_STATE_ENABLED="true"
# 干预预算与降频策略（默认 false）
INTERVENTION_BUDGET_ENABLED="true"
# 项目附件入口（图片 / PDF Inbox，默认 true）
PROJECT_INBOX_ENABLED="true"
# 交付物证据缺口介入（默认 true）
DELIVERABLE_GAP_ENABLED="true"

# ---- R2：阶段检查点 / 可执行安排 / 再入场 / 日历同步 / 记忆归并 ----
# 阶段检查点：来源冻结、确认版本、局部失效（默认 false）
PROJECT_EPISODES_ENABLED="true"
# 应用内确定性排程：只安排 READY 行动，未排入必带原因（默认 false）
PROJECT_SCHEDULING_ENABLED="true"
# 60 秒再入场聚合：App / 桌面卡片 / 小艺共用只读结果（默认 false）
PROJECT_REENTRY_ENABLED="true"
# 系统日历同步：需真机授权验收，未验收前保持关闭（默认 false）
PROJECT_CALENDAR_SYNC_ENABLED="false"
# 单条待办的日历提醒生命周期：安排 / 修改 / 撤销 / 重试（默认 false）
PROJECT_CALENDAR_REMINDER_ENABLED="false"
# 项目体检：只读、确定性聚合当前问题（默认 true，读取不产生业务写入）
PROJECT_HEALTH_ENABLED="true"
# 可撤销记忆归并：只归档重复卡并留回执，不删除原始记录（默认 false）
PROJECT_MEMORY_CONSOLIDATION_ENABLED="false"

# ---------------------------------------------------------------
# 6. 演示账号 / 演示情境
# ---------------------------------------------------------------
# 演示情境按钮（默认 true；设为 false 隐藏）
DEMO_SCENARIOS="true"
# 是否允许自动初始化演示账号；留空表示「仅非生产环境开启」
DEMO_USER_ENABLED=""
DEMO_USERNAME="contest-demo"
# 明文与哈希二选一即可，同时存在时哈希优先
DEMO_PASSWORD=""
DEMO_PASSWORD_HASH=""
DEMO_DISPLAY_NAME="复赛演示账号"
# 演示账号绑定的项目；不设置则不绑定任何项目，不再自动取库里最早的项目
DEMO_PROJECT_ID=""

# ---------------------------------------------------------------
# 7. 附件抽取
# ---------------------------------------------------------------
# 文本 PDF 抽取依赖外部 pdftotext（poppler-utils）；缺失时状态为 NEEDS_OCR 而不是静默失败
PDFTOTEXT_PATH="pdftotext"

# ---------------------------------------------------------------
# 8. 小艺适配层
# 默认全部关闭；只在公网 HTTPS + 反向代理认证之后启用，且必须使用独立 Bearer Token。
# ---------------------------------------------------------------
XIAOYI_ENABLED="false"
XIAOYI_ADAPTER_ENABLED="false"
# 生成方式：openssl rand -hex 32
XIAOYI_ADAPTER_TOKEN=""
XIAOYI_TEST_PROJECT_ID=""
XIAOYI_MISSION_ENABLED="false"
XIAOYI_TEST_USER_ID=""
XIAOYI_MISSION_ALLOWLIST=""
MISSION_UI_ENABLED="true"
MISSION_WIDGET_ENABLED="false"
XIAOYI_RATE_LIMIT_PER_MINUTE="60"
XIAOYI_PROPOSAL_TTL_MS="600000"
# 仅公网验收脚本 (verify:w03-public) 使用，默认指向正式评审后端
XIAOYI_BASE_URL="https://project.luojiatutor.xyz"

# 9. 账号邮件：缺少以下配置时，注册和找回密码保持关闭。
# Resend SMTP 示例；SMTP_FROM 必须属于已在 Resend 验证的域名。
AUTH_PUBLIC_BASE_URL="https://project.luojiatutor.xyz"
# 推荐 Resend HTTPS API；空值时服务保持关闭。
AUTH_MAIL_TRANSPORT="resend"
AUTH_EMAIL_FROM="忆程 <no-reply@mail.luojiatutor.xyz>"
RESEND_API_KEY=""
# 可选 SMTP：将 AUTH_MAIL_TRANSPORT 改为 smtp 后填写以下项。
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# 可选 Copilot 语义 Judge：默认关闭。启用后每次回答最多额外 3 次调用，计入账户云调用配额。
# 不可把规则/模型核验当作现实实验已完成的证明。
COPILOT_CLAIM_JUDGE_ENABLED="false"

# 同项目共享当前目标与下一步；关闭时回退原入口，个人关注数据保留
PROJECT_AGENT_CONTEXT_ENABLED=true

# 对话只提供预览；明确确认后才创建一个只读委托。关闭后拒绝未完成的转委托确认。
COPILOT_CONTINUATION_ENABLED="true"

# P2 影响路径、同委托方案对比、单项主动追问。开关不关闭已采用方案的提交校验。
TYPED_IMPACT_ENABLED="true"
DECISION_SCENARIOS_ENABLED="true"
GOAL_QUESTION_ENABLED="true"
# 主动展示仍要求现有 INTERVENTION_BUDGET_ENABLED=true，沿用 USER 预算与静默策略。

# P3-A 项目内经验复用：轨迹索引提炼 Workflow/Guardrail 候选，样本≥2 进入影子观察，
# 仅用户可激活；注入只是建议文本，不改变权限。关闭时停止注入与新同步，历史使用记录保留。
PROJECT_EXPERIENCE_ENABLED="true"

# P3-B 单仓库只读感知：公开仓库 commits 信号候选；仅在用户显式刷新时匿名请求 GitHub
# （ETag 条件请求，304 不计限额）。未采纳零事实写入；撤销连接立即停止新请求并保留历史。
REPO_SENSING_ENABLED="true"

# 下一阶段 P2：仅对新生成的 GPU 内存测量问题提出待用户核对的条件。
# 默认关闭；关闭不取消已有新版问题的核对要求，也不恢复自动标量接续。
# E0 预览无模型调用；原 Runner 和资料结构化仍遵守现有模型授权与预算。
MISSION_EVIDENCE_FIT_ENABLED="false"

# 用户级焦点协作：先部署迁移，再开启。关闭保留会话和原任务数据。
FOCUS_AGENT_ENABLED="false"
FOCUS_AGENT_FOLLOW_ENABLED="false"
GOAL_CHANGE_REVIEW_ENABLED="false"
# R4：角色消息、目标调查与 Web 语义块。须先开启 FOCUS_AGENT_ENABLED；原生块渲染另行升级 HAP。
FOCUS_AGENT_R4_ENABLED="false"
