# 忆程 ProjectMemo —— ECS 生产部署环境变量
#
# 变量全集与分组说明见仓库根目录 .env.example；本文件只列生产必须显式确认的那些，
# 并给出与本地开发不同的取值。新增变量时两处都要同步。
#
# 部署步骤见 docs/competition/projectmemo-ecs-backend-xiaoyi-hap-runbook.md

NODE_ENV=production

# ---- 数据与存储：必须落在持久卷，发布/重启不能覆盖 ----
DATABASE_URL=file:/opt/projectmemo/data/projectmemo.db
ATTACHMENT_DIR=/opt/projectmemo/storage

# ---- 发布标识：填实际部署的 commit，验收回执据此绑定 ----
PROJECTMEMO_RELEASE=REPLACE_WITH_VERIFIED_COMMIT

# ---- 模型（对话）----
# mock = 完全离线确定性回退，复赛演示默认用这个保证稳定；
# 切 openai-compatible 前先跑 `npm run verify:s03-provider` 并留回执。
LLM_MODE=mock
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-flash
# 留空 = 复用 LLM_MODEL_NAME（deepseek-flash 原生支持图片输入）
LLM_VISION_MODEL_NAME=
LLM_TIMEOUT_MS=30000

# ---- 模型（向量）----
# DeepSeek 对话预设不会被自动当作 embedding 服务；未配置时 Hybrid Search
# 走关键词/元数据 fallback，且不计入真实语义检索 Gate。
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_TIMEOUT_MS=15000
SEMANTIC_MEMORY_ENABLED=false

# ---- 功能开关 ----
TEMPORAL_MEMORY_ENABLED=true
EVIDENCE_TRUST_RECEIPT_ENABLED=true
PROJECT_STATE_ENABLED=true
INTERVENTION_BUDGET_ENABLED=true
PROJECT_INBOX_ENABLED=true
DELIVERABLE_GAP_ENABLED=true

# ---- 演示账号：生产必须关闭；演示数据由 seed 单独导入 ----
DEMO_SCENARIOS=false
DEMO_USER_ENABLED=false

# ---- 附件抽取 ----
PDFTOTEXT_PATH=pdftotext

# ---- 小艺适配层：仅在公网 HTTPS + 反向代理认证后开启 ----
# Token 生成：openssl rand -hex 32；只写入本机 root 可读的环境文件，不进 Git。
XIAOYI_ENABLED=true
XIAOYI_ADAPTER_ENABLED=true
XIAOYI_ADAPTER_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
XIAOYI_TEST_PROJECT_ID=REPLACE_WITH_FIXED_TEST_PROJECT_ID
XIAOYI_RATE_LIMIT_PER_MINUTE=60
XIAOYI_PROPOSAL_TTL_MS=600000
XIAOYI_BASE_URL=https://project.luojiatutor.xyz