generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

enum ProjectScenario {
  COURSE_DESIGN
  RESEARCH
  COMPETITION
  INNOVATION
  LAB_TASK
}

enum KnowledgeType {
  paper_note
  code_issue
  experiment_log
  meeting_note
  idea
  task
  risk
  requirement
  reflection
}

enum ArtifactType {
  weekly_report
  competition_outline
  defense_ppt
  readme
  resume_description
  next_week_plan
}

enum InterventionTrigger {
  DEADLINE_NEAR
  RISK_UNHANDLED
  PROJECT_STALE
  EXPERIMENT_GAP
  MATERIAL_GAP
  DELIVERABLE_GAP
}

enum InterventionStatus {
  OPEN
  ACCEPTED
  SNOOZED
  DISMISSED
  RESOLVED
}

enum ActionStatus {
  TODO
  DOING
  DONE
  CANCELLED
}

enum AgentRunType {
  CAPTURE
  EVALUATE
  ACTION
  ARTIFACT
  CHAT
}

enum AgentRunStatus {
  SUCCESS
  PARTIAL
  FALLBACK
  FAILED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum CardRelationType {
  RELATED
  SUPPORTS
  CONTRADICTS
  SUPERSEDES
  DERIVED_FROM
}

model Project {
  id          String              @id @default(cuid())
  title       String
  description String
  goal        String
  scenario    ProjectScenario
  deadline    DateTime?
  /// 归档是「不占主列表」的可恢复展示偏好，与事实有效性正交：
  /// 归档不改变记忆的时态状态、不删除快照与行动历史，也不能当作删除使用。
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  captures    Capture[]
  cards       KnowledgeCard[]
  lifecycleEvents MemoryLifecycleEvent[]
  stateSnapshots  ProjectStateSnapshot[]
  stateCursors    ProjectStateCursor[]
  stateFreshness  ProjectStateFreshness?
  interventionDecisions InterventionDecision[]
  interventionPreferences InterventionPreference[]
  artifacts   GeneratedArtifact[]
  interventions AgentIntervention[]
  actions     ActionItem[]
  runs        AgentRun[]
  messages    AgentMessage[]
  attachments Attachment[]
  milestones  Milestone[]
  memberships ProjectMembership[]
  episodes    ProjectEpisode[]
  schedulePlans SchedulePlan[]
  mergeReceipts MemoryMergeReceipt[]

  @@index([updatedAt])
  @@index([archivedAt])
}

model Capture {
  id         String        @id @default(cuid())
  projectId  String
  rawText    String
  sourceType String?
  // 同一项目内的客户端提交身份；NULL 保持旧客户端兼容。
  requestId  String?
  requestHash String?
  createdAt  DateTime      @default(now())
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  card       KnowledgeCard?

  @@index([projectId, createdAt])
  @@unique([projectId, requestId])
}

model KnowledgeCard {
  id              String              @id @default(cuid())
  projectId       String
  captureId       String              @unique
  attachmentId    String?
  type            KnowledgeType
  title           String
  summary         String
  keywords        Json
  relatedTasks    Json
  nextActions     Json
  importance      Int
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capture         Capture             @relation(fields: [captureId], references: [id], onDelete: Cascade)
  attachment      Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  embedding       CardEmbedding?
  outgoingLinks   CardRelation[]      @relation("CurrentCard")
  incomingLinks   CardRelation[]      @relation("RelatedCard")
  lifecycleEvents MemoryLifecycleEvent[]
  interventions   AgentIntervention[] @relation("InterventionEvidence")
  sourceActions   ActionItem[]        @relation("ActionSourceCard")
  resultingAction ActionItem?         @relation("ActionResultCard")

  @@index([projectId, createdAt])
  @@index([projectId, type])
  @@index([attachmentId])
}

model CardRelation {
  id            String        @id @default(cuid())
  currentCardId String
  relatedCardId String
  reason        String
  score         Int
  relationType  CardRelationType @default(RELATED)
  confidence    Float?
  confirmed     Boolean       @default(false)
  confirmedAt   DateTime?
  revokedAt     DateTime?
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime      @default(now())
  currentCard   KnowledgeCard @relation("CurrentCard", fields: [currentCardId], references: [id], onDelete: Cascade)
  relatedCard   KnowledgeCard @relation("RelatedCard", fields: [relatedCardId], references: [id], onDelete: Cascade)

  @@index([currentCardId, relatedCardId, relationType])
  @@index([relatedCardId])
  @@index([relationType, confirmed, revokedAt])
}

/// F1：行动结构化依赖。满足状态不持久化——每次按当前源数据重评，不信任客户端传入的 READY。
model ActionRequirement {
  id         String     @id @default(cuid())
  actionId   String
  projectId  String
  targetKind String
  targetId   String
  hard       Boolean    @default(true)
  note       String?
  createdAt  DateTime   @default(now())
  action     ActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

model GeneratedArtifact {
  id           String       @id @default(cuid())
  projectId    String
  artifactType ArtifactType
  content      String
  // 生成时逐句证据引用快照：[{ cardId, observedAt, title, summary }]。
  // 保存当时的卡片摘要，后续卡片被编辑/取代不影响历史回执；人工编辑的新版本不携带该字段（无法逐句回溯）。
  sourceRefs   Json?
  // E3 逐句映射：{ status: TEMPLATE_BOUND | UNMAPPED_MODEL, claims: [{ claimId, text, section, cardIds }] }。
  // 模型生成未提供映射时 status=UNMAPPED_MODEL，相关来源仅上下文级、语义未核验。
  claims       Json?
  createdAt    DateTime     @default(now())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model AgentIntervention {
  id              String              @id @default(cuid())
  projectId       String
  triggerType     InterventionTrigger
  dedupeKey       String
  status          InterventionStatus  @default(OPEN)
  severity        Int                 @default(3)
  title           String
  content         String
  evidence        Json
  proposedActions Json
  isSimulated     Boolean             @default(false)
  snoozedUntil    DateTime?
  dismissReason   String?
  handledAt       DateTime?
  evidenceCardId  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceCard    KnowledgeCard?      @relation("InterventionEvidence", fields: [evidenceCardId], references: [id], onDelete: SetNull)
  feedbacks       InterventionFeedback[]
  deliveries      InterventionDelivery[]
  actions         ActionItem[]        @relation("InterventionActions")

  @@unique([projectId, dedupeKey])
  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model ActionItem {
  id                   String               @id @default(cuid())
  projectId            String
  sourceInterventionId String?
  sourceCardId         String?
  // 同一主动提醒/提案的解阻操作幂等键；普通手工行动保持 NULL。
  dedupeKey            String?              @unique
  resultCardId         String?              @unique
  title                String
  description          String?
  priority             Int                  @default(3)
  status               ActionStatus         @default(TODO)
  estimatedMinutes     Int?
  // 依赖/估时编辑的持久化乐观版本；旧客户端不传时保持兼容。
  dependencyVersion    Int                  @default(1)
  requirements         ActionRequirement[]
  dueAt                DateTime?
  resultText           String?
  isSimulated           Boolean              @default(false)
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceIntervention   AgentIntervention?   @relation("InterventionActions", fields: [sourceInterventionId], references: [id], onDelete: SetNull)
  sourceCard           KnowledgeCard?       @relation("ActionSourceCard", fields: [sourceCardId], references: [id], onDelete: SetNull)
  resultCard           KnowledgeCard?       @relation("ActionResultCard", fields: [resultCardId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([sourceInterventionId])
}

model AgentRun {
  id             String          @id @default(cuid())
  projectId      String
  runType        AgentRunType
  status         AgentRunStatus
  provider       String
  externalRequestId String?
  trace          Json
  resultJson     Json?
  fallbackReason String?
  durationMs     Int?
  // 会议提案的唯一执行权。普通 CAPTURE 回执保持 NULL。
  confirmedAt    DateTime?
  createdAt      DateTime        @default(now())
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages       AgentMessage[]

  @@index([projectId, createdAt])
  @@index([projectId, runType])
  @@unique([provider, externalRequestId])
}

model AgentMessage {
  id              String            @id @default(cuid())
  projectId       String
  role            AgentMessageRole
  content         String
  citations       Json
  proposedActions Json
  runId           String?
  createdAt       DateTime          @default(now())
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run             AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model CardEmbedding {
  id          String        @id @default(cuid())
  cardId      String        @unique
  provider    String
  model       String
  dimensions  Int
  vectorJson  String
  contentHash String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  card        KnowledgeCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Attachment {
  id               String          @id @default(cuid())
  projectId        String
  type             String          // "IMAGE" | "PDF" | "FILE"
  storageKey       String
  fileName         String
  mimeType         String
  size             Int
  sha256           String
  extractedText    String?
  extractionStatus String          @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  extractionError  String?
  createdAt        DateTime        @default(now())
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards            KnowledgeCard[]
  revisions        AttachmentRevision[]

  @@index([projectId, sha256])
  @@index([projectId, createdAt])
}

/// 记忆生命周期审计：人工确认来源、关系确认/撤销、归档/恢复。
/// 事件写入与对应业务变更同事务提交；人工确认是来源声明，不是自动证明事实真实。
model MemoryLifecycleEvent {
  id         String                   @id @default(cuid())
  projectId  String
  cardId     String
  eventType  MemoryLifecycleEventType
  reason     String?
  actor      String                   @default("user")
  relationId String?
  createdAt  DateTime                 @default(now())
  card       KnowledgeCard            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([projectId, createdAt])
}

enum MemoryLifecycleEventType {
  CONFIRM
  RELATION_CONFIRM
  RELATION_REVOKE
  ARCHIVE
  RESTORE
}

/// 附件提取/人工纠错修订链：旧抽取结果保留，不随纠错覆盖。
model AttachmentRevision {
  id           String     @id @default(cuid())
  attachmentId String
  revisionIndex Int
  text         String
  source       String
  createdAt    DateTime   @default(now())
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([attachmentId, revisionIndex])
}

/// R2/S1：项目状态快照。唯一约束在 (projectId, sourceHash, policyVersion, evaluationKey)：
/// 相同输入与同一规则区间不重复生成；A→B→A 的再次发生必须保留为新的历史行。
model ProjectStateSnapshot {
  id                 String   @id @default(cuid())
  projectId          String
  // 项目内单调递增序号：latest/previous/check-in 全部按它排序，不依赖毫秒时间
  sequence           Int
  schemaVersion      Int
  policyVersion      String
  sourceHash         String
  evaluationKey      String
  contentHash        String
  observedAt         DateTime
  evaluatedAt        DateTime
  previousSnapshotId String?
  payload            Json
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 历史身份由 sequence 唯一确定；同一源版本在历史不同位置重现（A→B→A）天然各自成行
  @@unique([projectId, sequence])
  @@index([projectId, sourceHash])
  @@index([projectId, evaluatedAt])
}

/// 读游标：consumerKey 当前为单端安装身份；只推进不倒退，由用户显式“已了解”更新。
model ProjectStateCursor {
  id                 String   @id @default(cuid())
  projectId          String
  consumerKey        String
  lastSeenSnapshotId String
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, consumerKey])
}

/// 状态刷新尝试的持久化新鲜度。刷新失败时保留上一快照并标记 STALE/FAILED，
/// 不能让客户端把错误当成新的 0% 状态。
model ProjectStateFreshness {
  id            String   @id @default(cuid())
  projectId     String   @unique
  status        String   @default("STALE") // EMPTY | FRESH | STALE | FAILED
  snapshotId    String?
  errorCode     String?
  errorMessage  String?
  attemptedAt   DateTime?
  refreshedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// B1：干预策略。登录用户使用 scope=USER:<userId>，同一用户的多个项目共享预算；GLOBAL 仅兼容旧数据和无归属离线任务。
model InterventionPolicy {
  id               String   @id @default(cuid())
  scope            String   @unique @default("GLOBAL")
  timezone         String   @default("Asia/Shanghai")
  dailyBudget      Int      @default(3)
  quietStartMinute Int      @default(1380)
  quietEndMinute   Int      @default(480)
  version          Int      @default(1)
  isActive         Boolean  @default(true)
  /// 已确认的降频主题 [{ triggerType, since }]；延期只影响本次，单次忽略不永久屏蔽
  reducedTopics    Json?
  /// 建议状态 { triggerType, suggestedAt, dismissedAt } 防止重复提出
  suggestionState  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// 全局预算的原子扣减行；windowStart/windowEnd 允许时区切换时复用仍重叠的自然日窗口。
model InterventionBudgetLedger {
  id            String   @id @default(cuid())
  scope         String
  windowKey     String
  windowStartAt DateTime
  windowEndAt   DateTime
  timezone      String
  localDate     String
  dailyBudget   Int
  usedCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scope, windowKey])
  @@index([scope, windowStartAt, windowEndAt])
}

/// 降频/建议是项目主题偏好，不能落在全局策略 JSON 中影响其他项目。
model InterventionPreference {
  id                   String   @id @default(cuid())
  projectId            String
  triggerType          String
  reducedSince         DateTime?
  suggestionDismissedAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, triggerType])
  @@index([projectId, reducedSince])
}

/// 干预决策日志：FIRE/SUPPRESS 及原因。生成(应用内)、曝光、送达分开记录，未验证送达不宣称收到。
model InterventionDecision {
  id             String   @id @default(cuid())
  projectId      String
  candidateKey   String
  decision       String
  reasonCode     String
  whyNow         String
  evidenceRefs   Json?
  channel        String   @default("IN_APP")
  policyVersion  Int
  interventionId String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([candidateKey, createdAt])
  @@index([projectId, decision, createdAt])
}

/// 干预反馈：独立事件，曝光与反馈分开；重复反馈幂等。
model InterventionFeedback {
  id             String            @id @default(cuid())
  interventionId String
  projectId      String
  feedbackType   String
  reason         String?
  createdAt      DateTime          @default(now())
  intervention   AgentIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@unique([interventionId, feedbackType])
  @@index([projectId, createdAt])
}

/// 系统通知通道的发布回执，与应用内曝光和用户反馈分开；PUBLISHED 只表示系统 API 接受发布，不冒充用户已看到。
model InterventionDelivery {
  id             String            @id @default(cuid())
  interventionId String
  projectId      String
  channel        String
  deliveryKey    String
  status         String
  message        String?
  attemptedAt    DateTime          @default(now())
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  intervention   AgentIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@unique([interventionId, channel, deliveryKey])
  @@index([projectId, attemptedAt])
}

/// R2：阶段检查点。Episode 是"一个阶段的再入场判断"，DRAFT 可取消，
/// PUBLISHED 后不可原地覆盖；来源变化只把状态标为 PARTIALLY_STALE/STALE，不删除历史。
model ProjectEpisode {
  id          String   @id @default(cuid())
  projectId   String
  // MANUAL | MILESTONE | SNAPSHOT_RANGE；范围来源标识，不承载业务规则
  kind        String   @default("MANUAL")
  title       String   @default("")
  windowStart DateTime
  windowEnd   DateTime
  // DRAFT | PUBLISHED | PARTIALLY_STALE | STALE | ARCHIVED
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions   EpisodeRevision[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

/// 检查点修订：确认后只增不改。claims/sourceRefs 使用带 schemaVersion 的 JSON，
/// 只有出现跨检查点查询需求时才拆分为独立表。
model EpisodeRevision {
  id             String         @id @default(cuid())
  episodeId      String
  revision       Int
  baseSnapshotId String?
  endSnapshotId  String?
  // 生成时冻结的来源集合哈希；确认时按同一规范重算比对，不一致返回 409
  sourceHash     String
  sourceRefs     Json
  claims         Json
  summary        Json
  // TEMPLATE | MODEL | MODEL_FALLBACK_TEMPLATE；模型失败回退模板时保留原因
  generationMode String         @default("TEMPLATE")
  provider       String?
  fallbackReason String?
  // DRAFT | PUBLISHED
  status         String         @default("DRAFT")
  requestId      String?
  confirmedAt    DateTime?
  createdAt      DateTime       @default(now())
  episode        ProjectEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, revision])
  @@index([episodeId, status])
}

/// R2：确定性排程计划。DRAFT 只是预览，CONFIRMED 才占用应用内时段；
/// 排程不改变行动 TODO/DONE 状态，也不能当作完成回执。
/// userId 是个人时间的所有者：同一项目两名成员的安排互不占用。
model SchedulePlan {
  id                String   @id @default(cuid())
  projectId         String
  userId            String?
  episodeRevisionId String?
  requestId         String
  timezone          String   @default("Asia/Shanghai")
  rangeStart        DateTime
  rangeEnd          DateTime
  inputHash         String
  sourceSnapshotId  String?
  // 乐观版本：确认前行动/依赖变化时递增，客户端用 expectedVersion 提交
  version           Int      @default(1)
  // DRAFT | CONFIRMED | STALE | SUPERSEDED | CANCELLED
  status            String   @default("DRAFT")
  // 未安排原因随计划持久化：同 requestId 重放必须返回首次结果，不能变成空数组
  unscheduled       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blocks            ScheduleBlock[]

  @@unique([projectId, requestId])
  @@index([projectId, status])
  @@index([userId, status])
  @@index([projectId, rangeStart, rangeEnd])
}

/// 时段块。calendar* 字段只记录 ProjectMemo 自己写入系统日历的回执：
/// 更新/取消只作用于带 eventId 的块，绝不触碰用户原有日程。
model ScheduleBlock {
  id                 String       @id @default(cuid())
  planId             String
  actionId           String
  actionVersion      Int
  startAt            DateTime
  endAt              DateTime
  locked             Boolean      @default(false)
  reasonCode         String?
  calendarId         String?
  calendarEventId    String?
  // NONE | PENDING | SYNCED | FAILED | REVOKED
  calendarSyncStatus String?
  calendarSyncedAt   DateTime?
  calendarError      String?
  plan               SchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([actionId])
  @@index([calendarEventId])
}

/// 记忆归并回执：归并不删除原始 Capture、附件修订、关系与历史快照，
/// 原卡只标记归档；撤销按回执恢复，不重建数据。
model MemoryMergeReceipt {
  id              String   @id @default(cuid())
  projectId       String
  masterCardId    String
  mergedCardIds   Json
  reason          String
  similarityScore Float    @default(0)
  // ACTIVE | REVOKED
  status          String   @default("ACTIVE")
  requestId       String?
  /// 主卡与被归并卡集合的规范哈希；用于识别 requestId 是否被不同载荷复用
  inputHash       String?
  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([masterCardId])
  @@unique([projectId, requestId])
}

model Milestone {
  id           String        @id @default(cuid())
  projectId    String
  title        String
  targetDate   DateTime?
  status       String        @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  @@index([projectId, status])
}

model Deliverable {
  id               String                @id @default(cuid())
  milestoneId      String
  title            String
  expectedEvidence String                // JSON array of expected evidence types e.g. ["experiment_log", "paper_note"]
  status           String                @default("PENDING")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  milestone        Milestone             @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  evidences        DeliverableEvidence[]

  @@index([milestoneId])
}

model DeliverableEvidence {
  id            String      @id @default(cuid())
  deliverableId String
  cardId        String?
  attachmentId  String?
  evidenceType  String
  confirmed     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

model User {
  id           String              @id @default(cuid())
  username     String              @unique
  displayName  String
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     AuthSession[]
  memberships  ProjectMembership[]

  @@index([username])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model ProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}
